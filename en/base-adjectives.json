{
  "_meta": {
    "title": "Base adjectives and their attested degree forms",
    "language": "en",
    "description": "Adjectives that take comparative -er and superlative -est, each with the forms a public-domain dictionary actually prints. Answers what nothing else here answers: whether a word is an adjective at all. Every other inventory is verb- or noun-facing, so loom could peel agentive -er off a verb but had no way to know that `kind` and `sharp` are adjectives — which left comparative -er unimplementable and the `degree` dimension half-computed.\n\nThe forms are recorded, not derived. Webster's states them outright (`Big, a. [compar. Bigger; superl. Biggest.]`), so the doubling in bigger, the e-drop in braver and the suppletion in bad/worse are attested spellings rather than rule output. That makes this file a test of the spelling rules as much as an input to them: a rule that cannot produce `braver` from `brave` disagrees with a source, and the source wins.",
    "license": "CC-BY-4.0",
    "credits": "../CREDITS.md",
    "stability": {
      "tier": "unstable",
      "means": "Use it freely — that is what CC BY is for — but do not assume it holds still. Content churns and the schema may change without notice. Pin a commit if you depend on the shape.",
      "contract": "None. No deprecation period, no migration note guaranteed."
    },
    "coverage": "SEED. 143 adjectives, being those Webster's 1913 gives explicit degree forms for. Absence means UNRECORDED, never 'takes no comparative' — the dictionary prints the bracket where it chose to. Read it as an open world."
  },
  "_provenance": {
    "_note": "Recorded per batch, per the convention in base-verbs.json. `mined` = derived by code from a corpus named in PROVENANCE.md.",
    "batches": [
      {
        "date": "2026-08-27",
        "commit_subject": "base-adjectives: degree forms Webster's states outright",
        "method": "mined",
        "count": 80,
        "source": {
          "work": "Webster's Unabridged Dictionary (1913) — public domain by age",
          "url": "https://www.gutenberg.org/ebooks/29765",
          "consulted": "2026-08-27",
          "finding": "Adjective headwords whose entry opens with an explicit degree bracket — `Kind, a. [Compar. Kinder; superl. Kindest.]`. Extracted by regex over the Project Gutenberg plain text; the base, comparative and superlative are all taken verbatim from the bracket, and the `change` field is this project's classification of the spelling relation between them, not Webster's.",
          "excluded": "Two matches were dropped as OCR/parse noise, not data: `light` yielded 'lighted' and `mid` yielded 'wanting', neither of which is a comparative."
        }
      },
      {
        "date": "2026-08-27",
        "commit_subject": "base-adjectives: re-mined from the complete Webster's text",
        "method": "mined",
        "count": 143,
        "source": {
          "work": "Webster's Unabridged Dictionary (1913) — public domain by age",
          "url": "https://www.gutenberg.org/ebooks/29765",
          "consulted": "2026-08-27",
          "finding": "Re-run over the COMPLETE text. The first pass used a truncated download — 20,905,986 of 28,956,350 bytes, ending mid-R at 'relics' — so it saw no adjective after R and the file silently held only A-R. The truncation came from an HTTP/2 PROTOCOL_ERROR that ends the transfer at the same byte every time; --http1.1 fetches it whole."
        }
      }
    ]
  },
  "_change_values": {
    "plain": "base + er / est — cold, colder, coldest.",
    "e-drop": "silent e dropped before the vowel suffix — brave, braver, bravest.",
    "double": "final consonant doubled — big, bigger, biggest.",
    "y-to-i": "final y becomes i — the one case Webster's brackets here.",
    "irregular": "neither rule produces it. bad/worse/worst is suppletive and must be listed, not derived."
  },
