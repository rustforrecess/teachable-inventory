{
  "_meta": {
    "title": "Irregular English verb forms",
    "language": "en",
    "description": "A finite, teachable inventory of English verbs whose past tense and past participle are not formed by adding -ed. Every entry is (base, past, participle) plus the pattern class it belongs to, so a consumer can show a learner WHY a form looks the way it does rather than only that it does. Regular verbs are deliberately absent: they are derivable by rule and do not belong in a list. This is a morphology inventory, not a pronunciation lookup - it says nothing about sound, so it does not conflict with the from-letters principle in data/README.md.",
    "license": "CC-BY-4.0",
    "credits": "../CREDITS.md",
    "source_notes": "The pattern classes follow the traditional strong/weak verb distinction: 'strong' verbs mark tense by internal vowel change (Germanic ablaut) while 'weak' verbs add a dental suffix, which in English surfaces as -ed/-t. The groupings here are the conventional teaching families used in ELA and structured-literacy practice, not a novel classification. Individual verb forms are facts about English and are not copied from any curriculum's curated list.",
    "status": "seed - the high-frequency core. Expand toward the full inventory; coverage of rarer strong verbs is incomplete by design.",
    "consumers": [
      "vocabulary-measurement-system",
      "loom (tense rung)",
      "morpheme-ninja"
    ]
  },
  "_provenance": {
    "_note": "Who added what, when, and how. Recorded per BATCH rather than per entry: the data was created in batches, so batch records are honest and stay readable, while an entry needing individual sourcing (a teacher contribution, a single corrected form) may carry its own `prov` field.\n\nBatches are identified by DATE and COMMIT SUBJECT, deliberately not by commit hash. A hash means nothing to a human auditor and breaks the moment history is ever rewritten; a subject line is stable, readable, and findable with `git log --grep`.\n\n`method` is the load-bearing field. `authored` = compiled from facts by a person. `mined` = derived by code from a corpus named in PROVENANCE.md. `assistant` = drafted by an AI assistant at the maintainer's direction and accepted by the maintainer. All three produce uncopyrightable facts, so none affects the free-forever promise; recording which is which lets a downstream user filter and keeps the chain auditable by someone who was not here.",
    "batches": [
      {
        "date": "2026-07-21",
        "commit_subject": "data: irregular English verb forms inventory (CC BY 4.0)",
        "method": "assistant",
        "scope": "all 107 verbs and the 18 pattern classes",
        "by": "AI assistant, directed and accepted by the maintainer"
      }
    ]
  },
  "patterns": {
    "no-change": "All three forms are identical. Nothing is added and nothing changes.",
    "d-to-t": "Final -d becomes -t. The vowel does not change.",
    "vowel-shorten-t": "The vowel shortens and the ending becomes -t.",
    "i-a-u": "Three-way vowel change i - a - u across base, past and participle.",
    "ow-ew-own": "Past changes the vowel to -ew; the participle adds -n to the base vowel.",
    "eak-oke-oken": "Past takes -o-; the participle adds -en.",
    "ake-ook-aken": "Past takes -oo-; the participle adds -en.",
    "ive-ave-iven": "Past takes -a-; the participle adds -en.",
    "ide-ode-idden": "Past changes the vowel; the participle adds -en, often doubling the consonant.",
    "augh-ough": "Past and participle share an -ought / -aught spelling.",
    "ind-ound": "-ind becomes -ound in both past and participle.",
    "vowel-change-same": "The vowel changes and past and participle are identical.",
    "spelling-same-sound-change": "Past and participle look close to the base but the vowel sound changes.",
    "come-came-come": "The participle returns to the base form.",
    "distinct-participle": "All three forms differ; the participle usually ends -en.",
    "ear-ore-orn": "-ear becomes -ore in the past and -orn in the participle.",
    "regular-past-irregular-participle": "The past is regular (-ed) but the participle is irregular (-n).",
    "suppletive": "The past comes from a different root entirely; there is no pattern to derive it from."
  },
  "derivation": {
    "_note": "Prefixed verbs inflect like the base they are built on: withhold/withheld follows hold/held, overtake follows take. Consumers should strip a listed prefix and look up the remainder rather than expect every prefixed form to appear as its own row. Only prefixed forms whose inflection does NOT follow the base would need listing, and English has essentially none.",
    "pass_through_prefixes": [
      "counter",
      "inter",
      "under",
      "fore",
      "over",
      "with",
      "for",
      "mis",
      "out",
      "be",
      "re",
      "un",
      "up"
    ],
    "examples": {
      "withhold": "hold",
      "overtake": "take",
      "misunderstand": "understand",
      "rewrite": "write",
      "outgrow": "grow",
      "upset": "set"
    }
  },
