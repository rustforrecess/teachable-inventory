{
  "_meta": {
    "title": "Base verbs and their complement frames",
    "language": "en",
    "description": "A finite inventory of common English verbs in base form, each tagged with the complement frames it can take. Answers two different questions that no other file here answers: (1) is this word a verb at all - which pure suffix analysis cannot decide, since 'conduct' and 'plan' carry no inflection and '-s' is ambiguous between plural noun and third-person verb; and (2) what does this verb license - whether it can take an object, two objects, a clause, or none. Frames are the fact that lets a consumer reject a reading in which an intransitive verb has been given a direct object.",
    "license": "CC-BY-4.0",
    "credits": "../CREDITS.md",
    "source_notes": "Complement frames (subcategorization) are a standard descriptive category in English grammar; the six used here are the conventional teaching set. The gf_category field records the corresponding category name in Grammatical Framework's Resource Grammar Library, purely as an interoperability key - names of grammatical categories are not copyrightable and no GF code or data is used or derived from here. Recorded because GF's own engine is GPL-3.0 while its RGL is dual LGPL/BSD: if this project ever needs its own framework, this inventory should carry over unchanged.",
    "status": "seed - common core plus the copula/auxiliary set and common science-register verbs. Incomplete by design and expected to grow; a verb's absence means unknown, never 'not a verb'.",
    "framework_independence": "Deliberately engine-neutral. Frames are named in plain descriptive terms, with the GF category recorded alongside rather than instead. Nothing here assumes a parser, a formalism, or a programming language.",
    "consumers": [
      "vocabulary-measurement-system",
      "loom (clause rung licensing)",
      "morpheme-ninja"
    ],
    "see_also": "irregular-verbs.json holds the FORMS of verbs whose past is not -ed. This file holds what verbs COMBINE WITH. The two overlap in membership and neither subsumes the other: 'grow' appears in both, 'conduct' only here, and a verb may be irregular yet unremarkable in its frames."
  },
  "_provenance": {
    "_note": "Who added what, when, and how. Recorded per BATCH rather than per entry: the data was created in batches, so batch records are honest and stay readable, while an entry needing individual sourcing (a teacher contribution, a single corrected form) may carry its own `prov` field.\n\nBatches are identified by DATE and COMMIT SUBJECT, deliberately not by commit hash. A hash means nothing to a human auditor and breaks the moment history is ever rewritten; a subject line is stable, readable, and findable with `git log --grep`.\n\n`method` is the load-bearing field. `authored` = compiled from facts by a person. `mined` = derived by code from a corpus named in PROVENANCE.md. `assistant` = drafted by an AI assistant at the maintainer's direction and accepted by the maintainer. All three produce uncopyrightable facts, so none affects the free-forever promise; recording which is which lets a downstream user filter and keeps the chain auditable by someone who was not here.",
    "batches": [
      {
        "date": "2026-07-21",
        "commit_subject": "data: base verbs and their complement frames (CC BY 4.0)",
        "method": "assistant",
        "scope": "initial 118 verbs with complement frames",
        "by": "AI assistant, directed and accepted by the maintainer"
      },
      {
        "date": "2026-07-21",
        "commit_subject": "data: add the copula/auxiliary set and common science-register verbs (118 -> 155)",
        "method": "assistant",
        "scope": "+37: copula/auxiliary set and science-register verbs (118 -> 155)",
        "by": "AI assistant, directed and accepted by the maintainer",
        "prompted_by": "held-out NGSS measurement showed `be` was missing"
      }
    ]
  },
  "frames": {
    "intransitive": {
      "gloss": "Takes a subject and no object. \"Costs rose.\"",
      "gf_category": "V"
    },
    "transitive": {
      "gloss": "Takes a subject and one direct object. \"Students conduct investigations.\"",
      "gf_category": "V2"
    },
    "ditransitive": {
      "gloss": "Takes two objects. \"The company gave shareholders a dividend.\"",
      "gf_category": "V3"
    },
    "clausal": {
      "gloss": "Takes a that-clause as its complement. \"The report says that revenue increased.\"",
      "gf_category": "VS"
    },
    "linking": {
      "gloss": "Links the subject to a complement rather than acting on an object. \"The results are significant.\"",
      "gf_category": "VA"
    },
    "verb_complement": {
      "gloss": "Takes another verb as its complement. \"Students plan to investigate.\"",
      "gf_category": "VV"
    }
  },
